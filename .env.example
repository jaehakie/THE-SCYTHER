# Server environment only. app.py reads .env on startup.
# Explicit process environment takes precedence over .env.
# Explicitly select mock for keyless wiring checks. Default is openai.
CHAT_MODE=mock
# Required only for CHAT_MODE=openai; choose an available text Responses API model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# 1–50 seconds; browser waits 60 seconds.
LLM_TIMEOUT_SECONDS=45
